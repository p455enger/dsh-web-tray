  "version": "1.0.2",
  "type": "module",
  "license": "MIT",
  "author": "p455enger",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p455enger/dsh-web-tray.git"
  },
  "homepage": "https://github.com/p455enger/dsh-web-tray#readme",
  "bugs": {
    "url": "https://github.com/p455enger/dsh-web-tray/issues"
  },
  "bin": {
    "dsh-web-tray": "bin/dsh-web-tray.mjs"
  },
  "files": [
    "bin",
    "windows",
    "assets",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
